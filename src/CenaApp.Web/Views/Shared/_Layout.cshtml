@* Estructura común de todas las páginas: estilos, contenedor central de 512 px y barra de navegación inferior. *@
@{
    // Cada vista puede ocultar la barra (login, registro, onboarding) con ViewData["OcultarBarra"] = true.
    var ocultarBarra = ViewData["OcultarBarra"] as bool? ?? false;
    // Sección de la barra que queda marcada; la vista la indica con ViewData["Seccion"] = "Despensa", etc.
    var seccion = ViewData["Seccion"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CenaAPP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Bootstrap Icons, complementaria aprobada (D-10) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    <main class="contenedor @(ocultarBarra ? "sin-barra" : "")">
        @RenderBody()
    </main>

    @if (!ocultarBarra)
    {
        <footer class="barra-inferior">
            <nav aria-label="Navegación principal">
                <a asp-controller="Recetas" asp-action="Index" class="@(seccion == "Inicio" ? "activo" : "")">
                    <i class="bi bi-house-door"></i>Inicio
                </a>
                <a asp-controller="Despensa" asp-action="Index" class="@(seccion == "Despensa" ? "activo" : "")">
                    <i class="bi bi-basket"></i>Despensa
                </a>
                <a asp-controller="Tiendas" asp-action="Index" class="@(seccion == "Tiendas" ? "activo" : "")">
                    <i class="bi bi-geo-alt"></i>Tiendas
                </a>
                <a asp-controller="Perfil" asp-action="Index" class="@(seccion == "Perfil" ? "activo" : "")">
                    <i class="bi bi-person"></i>Perfil
                </a>
            </nav>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
