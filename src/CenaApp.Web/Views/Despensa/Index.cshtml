@* Mi Despensa (DISENO.md §1.5). El bloque #contenido-despensa lo reemplaza js/despensa.js con lo que responde el servidor. *@
@model CenaApp.Web.ViewModels.DespensaViewModel
@{
    ViewData["Title"] = "Mi despensa";
    ViewData["Seccion"] = "Despensa";
}

<header class="encabezado encabezado-despensa">
    <h1><i class="bi bi-basket"></i> Mi Despensa</h1>
    <p>Ingresá los ingredientes que tenés en casa y te sugerimos recetas.</p>
</header>

<div class="cuerpo">
    <section class="tarjeta superpuesta">
        <h2 class="fs-6 mb-3"><i class="bi bi-plus-circle text-success"></i> Agregar ingrediente</h2>
        @* Formulario de la Parte 15: input + botón + fetch (js/despensa.js). Sin JavaScript, se envía normal. *@
        <form id="form-agregar" asp-action="Agregar" method="post" class="d-flex gap-2" autocomplete="off">
            <div class="buscador flex-grow-1">
                <i class="bi bi-search"></i>
                <input name="texto" class="form-control borde" list="catalogo-ingredientes" placeholder="Escribí o elegí de la lista..." aria-label="Ingrediente" required />
            </div>
            <button type="submit" class="btn btn-despensa" aria-label="Agregar"><i class="bi bi-plus-lg"></i></button>
        </form>
        @* Sugerencias del navegador: nombre del ingrediente, con sus sinónimos como ayuda. *@
        <datalist id="catalogo-ingredientes">
            @foreach (var (nombre, sinonimos) in Model.Catalogo)
            {
                <option value="@nombre">@sinonimos</option>
            }
        </datalist>
    </section>

    <div id="contenido-despensa" aria-live="polite">
        <partial name="_Contenido" model="Model.Contenido" />
    </div>
</div>

@section Scripts {
    <script src="~/js/despensa.js" asp-append-version="true"></script>
}
