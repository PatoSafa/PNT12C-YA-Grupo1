@* Pantalla provisoria para el usuario logueado. Se reemplaza por el Inicio de recetas (T12). *@
@model CenaApp.Web.ViewModels.InicioViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Seccion"] = "Inicio";
}

<header class="encabezado encabezado-inicio">
    <h1>Hola, @Model.Nombre! 👋</h1>
    <p>@(Model.EsAdmin ? "Entraste como administrador." : "¿Qué vamos a cocinar hoy?")</p>
</header>

<div class="cuerpo">
    <section class="tarjeta superpuesta">
        @if (Model.BaseConectada)
        {
            <p class="mb-3 text-success"><i class="bi bi-check-circle"></i> Base de datos PostgreSQL: conectada.</p>
        }
        else
        {
            <p class="mb-3 text-danger"><i class="bi bi-exclamation-circle"></i> Base de datos PostgreSQL: sin conexión. ¿Levantaste el contenedor con <code>docker compose up -d</code>?</p>
        }
        <form asp-controller="Cuenta" asp-action="Salir" method="post">
            <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
        </form>
    </section>
</div>
