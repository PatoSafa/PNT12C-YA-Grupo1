@model CenaApp.Web.ViewModels.InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-5">CenaAPP</h1>
    <p>El proyecto está corriendo.</p>
    @if (Model.BaseConectada)
    {
        <p class="text-success">Base de datos PostgreSQL: conectada.</p>
    }
    else
    {
        <p class="text-danger">Base de datos PostgreSQL: sin conexión. ¿Levantaste el contenedor con <code>docker compose up -d</code>?</p>
    }
</div>
