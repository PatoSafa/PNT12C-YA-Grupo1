# Normaliza finales de línea para que Windows/Mac/Linux no generen diffs falsos
* text=auto

# Scripts de Unix siempre con LF (gradlew falla en Render/Linux si tiene CRLF)
gradlew text eol=lf
*.sh    text eol=lf

# Scripts de Windows con CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binarios: no tocar
*.jar   binary
*.png   binary
*.jpg   binary
*.docx  binary
*.pdf   binary
