@* Mis favoritos: las recetas que el usuario marcó con el corazón (RF12). *@
@model List<CenaApp.Web.ViewModels.TarjetaRecetaViewModel>
@{
    ViewData["Title"] = "Mis favoritos";
    ViewData["Seccion"] = "Inicio";
}

<header class="encabezado encabezado-inicio">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-vidrio btn-sm" aria-label="Volver al inicio"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1>Mis favoritos</h1>
            <p>@Model.Count @(Model.Count == 1 ? "receta guardada" : "recetas guardadas")</p>
        </div>
    </div>
</header>

<div class="cuerpo mt-3">
    @if (Model.Count == 0)
    {
        <section class="tarjeta vacio">
            <i class="bi bi-heart icono"></i>
            <p>Todavía no guardaste recetas. Tocá el corazón de una receta para tenerla acá.</p>
            <a asp-action="Index" class="btn btn-primary">Ver recetas</a>
        </section>
    }
    else
    {
        @foreach (var receta in Model)
        {
            <partial name="_TarjetaReceta" model="receta" />
        }
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/favoritos.js" asp-append-version="true"></script>
}
