@* Perfil en modo lectura: datos, preferencias y cierre de sesión. *@
@model CenaApp.Web.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Seccion"] = "Perfil";
}

<header class="encabezado encabezado-perfil">
    <div class="d-flex justify-content-between align-items-start">
        <h1>Mi Perfil</h1>
        <a asp-action="Editar" class="btn btn-vidrio btn-sm"><i class="bi bi-pencil"></i> Editar</a>
    </div>
    <div class="d-flex align-items-center gap-3 mt-3">
        <div class="avatar"><i class="bi bi-person"></i></div>
        <div>
            <h2 class="fs-4 mb-0">@Model.Nombre</h2>
            <p>Nivel: @Model.Nivel · @Model.Email</p>
        </div>
    </div>
</header>

<div class="cuerpo">
    <section class="tarjeta superpuesta">
        <h3 class="fs-6"><i class="bi bi-slash-circle text-warning"></i> Restricciones alimentarias</h3>
        @if (Model.Restricciones.Count == 0)
        {
            <p class="text-secondary mb-0">Ninguna</p>
        }
        else
        {
            <div class="chips">
                @foreach (var r in Model.Restricciones)
                {
                    <span class="etiqueta">@r</span>
                }
            </div>
        }
    </section>

    <section class="tarjeta">
        <h3 class="fs-6"><i class="bi bi-exclamation-triangle text-danger"></i> Alergias</h3>
        @if (Model.Alergenos.Count == 0)
        {
            <p class="text-secondary mb-0">Ninguna</p>
        }
        else
        {
            <div class="chips">
                @foreach (var a in Model.Alergenos)
                {
                    <span class="etiqueta etiqueta-alergia">@a</span>
                }
            </div>
        }
    </section>

    <section class="tarjeta">
        <h3 class="fs-6"><i class="bi bi-heart text-danger"></i> Gustos culinarios</h3>
        @if (Model.Gustos.Count == 0)
        {
            <p class="text-secondary mb-0">No especificado</p>
        }
        else
        {
            <div class="chips">
                @foreach (var g in Model.Gustos)
                {
                    <span class="etiqueta etiqueta-gusto">@g</span>
                }
            </div>
        }
    </section>

    <section class="consejo mb-3">
        <strong>💡 Consejo</strong>
        <p class="mb-0">Mantené tu perfil actualizado para recibir las mejores recomendaciones de recetas según tus preferencias y necesidades.</p>
    </section>

    <form asp-controller="Cuenta" asp-action="Salir" method="post">
        <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
    </form>
</div>
