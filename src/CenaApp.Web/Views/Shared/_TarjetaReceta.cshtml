@* Tarjeta horizontal de una receta; se usa en Inicio y en Mis favoritos. Toda la tarjeta lleva al detalle
   (stretched-link), y el corazón queda por encima para marcar favorito sin entrar. *@
@model CenaApp.Web.ViewModels.TarjetaRecetaViewModel

<div class="tarjeta-receta">
    <div class="emoji" aria-hidden="true">@Model.Emoji</div>
    <div class="datos">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h3>
                <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@Model.Id" class="stretched-link">@Model.Nombre</a>
            </h3>
            <partial name="_BotonFavorito" model="(Model.Id, Model.EsFavorita)" />
        </div>
        @if (!string.IsNullOrEmpty(Model.Descripcion))
        {
            <p class="descripcion">@Model.Descripcion</p>
        }
        <div class="meta">
            <span><i class="bi bi-clock"></i> @Model.TiempoMin min</span>
            <span><i class="bi bi-people"></i> @Model.Porciones @(Model.Porciones == 1 ? "porción" : "porciones")</span>
            <partial name="_Dificultad" model="Model.Dificultad" />
        </div>
    </div>
</div>
